# Copie este arquivo para .env e ajuste os valores antes de subir o projeto.

# Banco de dados
POSTGRES_DB=financas
POSTGRES_USER=financas
POSTGRES_PASSWORD=financas

# Usuário administrador inicial (criado só se ainda não existir nenhum usuário)
APP_ADMIN_USER=marlus
APP_ADMIN_PASSWORD=marlus

# Fuso horário usado pelos containers
TZ=America/Fortaleza
